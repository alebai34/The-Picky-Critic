[sub_resource type="Shader" id="Shader_rnek7"]
code = "shader_type canvas_item;

// 0.0 = lying flat, 1.0 = folded all the way onto the spine.
uniform float fold : hint_range(0.0, 1.0) = 0.0;
// Current rect width in pixels — set from script each turn (size can change).
uniform float page_width = 200.0;
// true if this page's spine (the edge it pivots on) is its right edge.
uniform bool pivot_right = false;

void vertex() {
	// Distance from the spine, in pixels, regardless of which side it's on.
	float sx = pivot_right ? (page_width - VERTEX.x) : VERTEX.x;
	float collapsed = sx * (1.0 - fold);
	VERTEX.x = pivot_right ? (page_width - collapsed) : collapsed;
}

void fragment() {
	COLOR = texture(TEXTURE, UV);
	// 0 at the spine, 1 at the outer edge — used for shading, not geometry.
	float sx_n = pivot_right ? (1.0 - UV.x) : UV.x;

	// Shadow deepens near the spine as the page folds toward it.
	float shadow = (1.0 - smoothstep(0.0, 1.0, sx_n)) * fold;
	COLOR.rgb *= mix(1.0, 0.35, shadow);

	// A thin bright rim right at the curling edge fakes light catching the roll.
	float rim = 1.0 - smoothstep(0.0, 0.08, sx_n);
	COLOR.rgb += rim * fold * 0.35;
}
"

